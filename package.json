{
  "dependencies": {
    "hono": "^4"
  },
  "description": "Massr (wasamas/massr) の Cloudflare ネイティブ移植版",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5",
    "typescript": "^7",
    "vitest": "^5.1.1",
    "wrangler": "^4"
  },
  "license": "GPL-3.0",
  "name": "massr-cf",
  "private": true,
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply massr-cf --local",
